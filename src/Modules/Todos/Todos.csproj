<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-contained Todos module: its own domain, application logic, persistence
       (schema + migrations) and HTTP endpoints. The host only sees IModule. -->

  <PropertyGroup>
    <!-- Mapperly: RMG012 (unmapped source member), RMG020 (unmapped target member) -->
    <NoWarn>$(NoWarn);RMG012;RMG020</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="PediatR" />
    <PackageReference Include="Riok.Mapperly" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\BuildingBlocks.csproj" />
  </ItemGroup>

</Project>
